# Next.js origin allowed to call Django's JSON API.
FRONTEND_ORIGIN=http://localhost:3000
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# For cross-site production deployments, use HTTPS with SameSite=None and Secure=true.
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=false

# Set these to stable secrets and production URLs when deploying.
DJANGO_SECRET_KEY=
